{
  "name": "dsh-web-fetch-policy",
  "version": "0.2.0",
  "description": "Configurable private-network policy HTTP(S) fetch provider for DeepSeek Harness",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caidwang/dsh-web-fetch-policy.git"
  },
  "main": "./lib/index.mjs",
  "types": "./lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-http-proxy": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-timeout": "^0.1.2-rc.1 || 0.1.6-alpha.2",
    "@deepseek-ai/dsh-web": "^0.1.2-rc.1 || 0.1.6-alpha.2",
    "@deepseek-ai/dsh-settings": "^0.1.2-rc.1 || 0.1.6-alpha.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-http-proxy": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2",
    "ipaddr.js": "^2.5.0",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-http-proxy": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-timeout": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-web": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-settings": "0.1.6-alpha.2",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "react": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0"
}
